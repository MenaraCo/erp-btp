{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true
      }
    ]
  },
  "globalSetup": "<rootDir>/support/global-setup.cjs",
  "globalTeardown": "<rootDir>/support/global-teardown.cjs",
  "setupFiles": [
    "<rootDir>/support/env.setup.cjs"
  ],
  "maxWorkers": 1,
  "testTimeout": 120000,
  "workerIdleMemoryLimit": "512MB"
}
