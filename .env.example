# --- API ---
NODE_ENV=development
API_PORT=3001

# --- PostgreSQL ---
# Used by both the running API and the TypeORM CLI (migrations).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=erp
DATABASE_PASSWORD=erp
DATABASE_NAME=erp_btp

# --- Tenancy (phase 0.2) ---
# Base domain used to derive the tenant slug from sub-domains (e.g. acme.localhost -> "acme").
TENANT_BASE_DOMAIN=localhost
