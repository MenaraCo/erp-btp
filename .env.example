# --- API ---
NODE_ENV=development
API_PORT=3001

# --- PostgreSQL ---
# Owner/superuser role: used by the TypeORM CLI for DDL and migrations.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=erp
DATABASE_PASSWORD=erp
DATABASE_NAME=erp_btp

# Non-privileged application role (NOBYPASSRLS): used by the running API so that
# Row-Level Security is actually enforced. Created by `pnpm db:local` / provisioning.
DATABASE_APP_USER=erp_app
DATABASE_APP_PASSWORD=erp_app

# --- Tenancy (phase 0.2) ---
# Base domain used to derive the tenant slug from sub-domains (e.g. acme.localhost -> "acme").
TENANT_BASE_DOMAIN=localhost

# --- Subscriptions (phase 0.5) ---
# Require a payment method to start the 30-day trial. Default false (no card at sign-up).
TRIAL_REQUIRES_PAYMENT_METHOD=false

# --- Auth (phase 0.7) ---
# Secret used to sign access tokens. MUST be set to a strong random value in production.
JWT_SECRET=dev-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL_SEC=3600
